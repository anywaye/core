#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module="$here/../numeric_check.py"

if [ ! -r "$module" ]; then
  echo "numeric-check: $module is missing — this is not a anywaye/core checkout." >&2
  exit 2
fi

minimum="3.9"
candidates=()
if [ -n "${ANYWAYE_NUMERIC_PYTHON:-}" ]; then
  candidates+=("$ANYWAYE_NUMERIC_PYTHON")
fi
candidates+=(python3 python3.13 python3.12 python3.11 python3.10 python3.9 python)

for candidate in "${candidates[@]}"; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  if ! "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' \
    >/dev/null 2>&1; then
    echo "numeric-check: $candidate is older than python $minimum." >&2
    exit 2
  fi
  exec "$candidate" "$module" "$@"
done

echo "numeric-check: no python >= $minimum found on PATH." >&2
echo "  Set ANYWAYE_NUMERIC_PYTHON to an interpreter, or install one." >&2
exit 2
