#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module="$here/../anywaye_contract.py"

if [ ! -r "$module" ]; then
  echo "anywaye-contract: $module is missing — this is not a anywaye/core checkout." >&2
  echo "  Point --core at a anywaye/core checkout, and get anywaye-contract from there." >&2
  exit 2
fi

minimum="3.9"
candidates=()
if [ -n "${ANYWAYE_CONTRACT_PYTHON:-}" ]; then
  candidates+=("$ANYWAYE_CONTRACT_PYTHON")
fi
candidates+=(python3 python python3.13 python3.12 python3.11 python3.10 python3.9)

for candidate in "${candidates[@]}"; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  if ! "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' \
    >/dev/null 2>&1; then
    echo "anywaye-contract: $candidate is older than python $minimum." >&2
    echo "  The harness uses only the standard library, so any python >= $minimum will do." >&2
    exit 2
  fi
  exec "$candidate" "$module" "$@"
done

echo "anywaye-contract: no python >= $minimum found on PATH." >&2
echo "  Set ANYWAYE_CONTRACT_PYTHON to an interpreter, or install one. The harness" >&2
echo "  needs no packages, so any python >= $minimum is enough." >&2
exit 2
