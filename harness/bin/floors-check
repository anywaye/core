#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module="$here/../floors_check.py"

if [ ! -r "$module" ]; then
  echo "floors-check: $module is missing — this is not a anywaye/core checkout." >&2
  exit 2
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "floors-check: python3 not found on PATH." >&2
  exit 2
fi

python3 - "$module" "$@" <<'PY'
import re
import subprocess
import sys

module = sys.argv[1]
arguments = sys.argv[2:]

if "--explain" in arguments:
    with open(module, encoding="utf-8") as handle:
        text = handle.read()
    print(re.search(r'^"""(.*?)"""', text, re.S | re.M).group(1).strip())
    raise SystemExit(0)

raise SystemExit(subprocess.run([sys.executable, module, *arguments]).returncode)
PY