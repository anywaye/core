#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module="$here/../tenancy_check.py"

DEFAULT_LIAR="$here/../tests/fixtures/tenancy/liar"

repo=""
liar=""
expect="tenancy.scope-lost"
positionals=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --expect)
      if [ "$#" -lt 2 ]; then
        echo "tenancy-proof: --expect needs a finding id (run: tenancy-check --explain)." >&2
        exit 2
      fi
      expect="$2"
      shift 2
      ;;
    -*)
      echo "tenancy-proof: unknown option $1." >&2
      echo "  usage: tenancy-proof <repo> [liar-repo] [--expect <finding-id>]" >&2
      exit 2
      ;;
    *)
      positionals=$((positionals + 1))
      if [ "$positionals" -gt 2 ]; then
        echo "tenancy-proof: one repository and one liar, in that order." >&2
        echo "  usage: tenancy-proof <repo> [liar-repo] [--expect <finding-id>]" >&2
        exit 2
      fi
      if [ "$positionals" -eq 1 ]; then
        repo="$1"
      else
        liar="$1"
      fi
      shift
      ;;
  esac
done

if [ -z "$repo" ]; then
  repo="."
fi
if [ -z "$liar" ]; then
  liar="$DEFAULT_LIAR"
fi

if [ ! -r "$module" ]; then
  echo "tenancy-proof: $module is missing — this is not a anywaye/core checkout." >&2
  exit 2
fi

if [ ! -d "$liar" ]; then
  echo "tenancy-proof: the liar fixture is not a directory: $liar" >&2
  echo "  Pass the path as the second argument, or use core's own fixture at" >&2
  echo "  $DEFAULT_LIAR. A missing liar is exit 2, not a pass." >&2
  exit 2
fi
if [ ! -d "$repo" ]; then
  echo "tenancy-proof: the repository to check is not a directory: $repo" >&2
  exit 2
fi

minimum="3.9"
candidates=()
if [ -n "${ANYWAYE_TENANCY_PYTHON:-}" ]; then
  candidates+=("$ANYWAYE_TENANCY_PYTHON")
fi
candidates+=(python3 python3.13 python3.12 python3.11 python3.10 python3.9 python)

python=""
for candidate in "${candidates[@]}"; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  if ! "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' \
    >/dev/null 2>&1; then
    echo "tenancy-proof: $candidate is older than python $minimum; trying the next candidate." >&2
    continue
  fi
  python="$candidate"
  break
done
if [ -z "$python" ]; then
  echo "tenancy-proof: no python >= $minimum found on PATH." >&2
  echo "  Set ANYWAYE_TENANCY_PYTHON to an interpreter. The checker needs no packages," >&2
  echo "  so any python >= $minimum is enough — but without one this proof could not" >&2
  echo "  run, and a proof that did not run is not a pass." >&2
  exit 2
fi

liar_out="$("$python" "$module" "$liar" 2>&1)" && liar_code=0 || liar_code=$?

if [ "$liar_code" -eq 2 ]; then
  echo "tenancy-proof: the checker could not run on the liar (exit 2)." >&2
  echo "  A run that could not happen is not a pass:" >&2
  printf '%s\n' "$liar_out" | sed 's/^/  /' >&2
  exit 2
fi
if [ "$liar_code" -ne 1 ]; then
  echo "tenancy-proof: THE LIAR PASSED (exit $liar_code). This is the failure this step exists for:" >&2
  echo "  a declaration that is schema-valid, complete and FALSE got a green from the" >&2
  echo "  tenancy checker, so this repository's own green declaration is not evidence of" >&2
  echo "  anything. Either the checker changed under the fixture or the fixture drifted;" >&2
  echo "  do not silence this by weakening the assertion." >&2
  printf '%s\n' "$liar_out" | sed 's/^/  /' >&2
  exit 1
fi
if ! printf '%s' "$liar_out" | grep -Eq "^FAIL $(printf '%s' "$expect" | sed 's/\./\\./g')(:|$)"; then
  echo "tenancy-proof: the liar went red (exit 1) but did NOT name $expect." >&2
  echo "  A red for the wrong reason is not a proof: the claim is that the check written" >&2
  echo "  for this defect is still load-bearing, not that something somewhere failed." >&2
  echo "  If the liar is meant to trip a different finding, pass --expect <finding-id>." >&2
  printf '%s\n' "$liar_out" | sed 's/^/  /' >&2
  exit 1
fi
liar_failures="$(printf '%s\n' "$liar_out" | awk '/^FAIL tenancy\./ { found++ } END { print found + 0 }')"

truth_out="$("$python" "$module" "$repo" 2>&1)" && truth_code=0 || truth_code=$?

if [ "$truth_code" -eq 2 ]; then
  echo "tenancy-proof: the checker could not run on $repo (exit 2)." >&2
  echo "  A run that could not happen is not a pass:" >&2
  printf '%s\n' "$truth_out" | sed 's/^/  /' >&2
  exit 2
fi
if [ "$truth_code" -ne 0 ]; then
  echo "tenancy-proof: this repository's own declaration is RED (exit $truth_code), so the" >&2
  echo "  pass-on-truth arm failed. Fix what the checker names before relying on this" >&2
  echo "  proof; a gate step run over a red tree proves the liar and nothing else." >&2
  printf '%s\n' "$truth_out" | sed 's/^/  /' >&2
  exit 1
fi
truth_failures="$(printf '%s\n' "$truth_out" | awk '/^FAIL tenancy\./ { found++ } END { print found + 0 }')"
truth_warnings="$(printf '%s\n' "$truth_out" | awk '/^WARN tenancy\./ { warned++ } END { print warned + 0 }')"

printf 'tenancy-proof: the liar failed as required — %s failure(s), %s named\n' \
  "$liar_failures" "$expect"
printf 'tenancy-proof: the truth passed — %s has 0 failure(s)', "$repo"
if [ "$truth_warnings" -gt 0 ]; then
  printf ' and %s warning(s), which never move the exit code' "$truth_warnings"
fi
printf '\n'
printf 'tenancy-proof: both directions held. The tenancy check on this repository can fail, and did.\n'
