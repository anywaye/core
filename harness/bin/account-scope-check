#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module="$here/../account_scope_check.py"

if [ ! -r "$module" ]; then
  echo "account-scope-check: $module is missing — this is not a anywaye/core checkout." >&2
  echo "  account_scope_check.py travels with harness/tenancy_check.py; a copy of one" >&2
  echo "  without the other would mean two answers to one question." >&2
  exit 2
fi

minimum="3.9"
candidates=()
if [ -n "${ANYWAYE_ACCOUNT_SCOPE_PYTHON:-}" ]; then
  candidates+=("$ANYWAYE_ACCOUNT_SCOPE_PYTHON")
fi
candidates+=(python3 python3.13 python3.12 python3.11 python3.10 python3.9 python)

for candidate in "${candidates[@]}"; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  if ! "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' \
    >/dev/null 2>&1; then
    echo "account-scope-check: $candidate is older than python $minimum." >&2
    echo "  This check reads no TOML and runs no process, so $minimum is the floor it" >&2
    echo "  inherited from harness/tenancy_check.py. It needs no packages." >&2
    exit 2
  fi
  exec "$candidate" "$module" "$@"
done

echo "account-scope-check: no python >= $minimum found on PATH." >&2
echo "  Set ANYWAYE_ACCOUNT_SCOPE_PYTHON to an interpreter, or install one." >&2
echo "  account-scope-check needs no packages, so any python >= $minimum is enough." >&2
exit 2