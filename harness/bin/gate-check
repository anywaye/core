#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module="$here/../gate_check.py"

if [ ! -r "$module" ]; then
  echo "gate-check: $module is missing — this is not a anywaye/core checkout." >&2
  echo "  gate_check.py travels with harness/anywaye_contract.py; a copy of one" >&2
  echo "  without the other would mean a second YAML dialect." >&2
  exit 2
fi

minimum="3.11"
candidates=()
if [ -n "${ANYWAYE_GATE_PYTHON:-}" ]; then
  candidates+=("$ANYWAYE_GATE_PYTHON")
fi
candidates+=(python3 python3.13 python3.12 python3.11 python)

for candidate in "${candidates[@]}"; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  if ! "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' \
    >/dev/null 2>&1; then
    echo "gate-check: $candidate is older than python $minimum." >&2
    echo "  gate-check reads mise.toml with tomllib, which is stdlib from 3.11." >&2
    echo "  It needs no packages, so any python >= $minimum will do." >&2
    exit 2
  fi
  exec "$candidate" "$module" "$@"
done

echo "gate-check: no python >= $minimum found on PATH." >&2
echo "  Set ANYWAYE_GATE_PYTHON to an interpreter, or install one. gate-check" >&2
echo "  needs no packages, so any python >= $minimum is enough." >&2
exit 2
