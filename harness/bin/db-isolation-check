#!/usr/bin/env bash
#
# db-isolation-check — can one test in this service's suite delete another's rows?
#
#   db-isolation-check .              # this service, or a fleet root
#   db-isolation-check ..             # every service beside this checkout
#   db-isolation-check --explain      # every finding this checker can report
#   db-isolation-check . --json       # the same findings, as JSON
#
# A wrapper, for the same three reasons harness/bin/gate-check is one: a service's
# CI should not have to know the module's file name, a missing or too-old
# interpreter is the most common way this fails, and a green badge is only worth
# what the exit code is worth.
#
# THE EXIT CODES, WHICH ARE THE WHOLE CONTRACT
#
#   0   no failure. Latent findings are still printed; see below.
#   1   at least one failure — the hazard is present, or is present minus the
#       thing that would set it off.
#   2   the check could not happen. Never 0, and never collapsed into 1.
#
# THIS SCRIPT NEVER LIFTS THE EXIT CODE AND NEVER ADDS A `|| true`. A wrapper
# that turns a refusal into a pass is worse than no wrapper, because the one
# thing a caller was relying on — the exit code — is the thing it discarded.
#
# PYTHON 3.9, AND WHY THIS FILE IS NOT 3.11
#
# harness/bin/gate-check needs 3.11 because it reads `mise.toml` and `tomllib` is
# stdlib from 3.11. This one reads no TOML and runs no process, so it runs on the
# same floor as harness/bin/anywaye-contract: a check that needs an interpreter a
# service's CI does not have is a check that runs nowhere. See
# docs/db-isolation.md.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module="$here/../db_isolation_check.py"

if [ ! -r "$module" ]; then
  echo "db-isolation-check: $module is missing — this is not a anywaye/core checkout." >&2
  echo "  db_isolation_check.py travels with harness/gate_check.py; a copy of one" >&2
  echo "  without the other would mean two answers to one question." >&2
  exit 2
fi

minimum="3.9"
candidates=()
if [ -n "${ANYWAYE_DB_ISOLATION_PYTHON:-}" ]; then
  candidates+=("$ANYWAYE_DB_ISOLATION_PYTHON")
fi
candidates+=(python3 python3.13 python3.12 python3.11 python3.10 python3.9 python)

for candidate in "${candidates[@]}"; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  if ! "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' \
    >/dev/null 2>&1; then
    echo "db-isolation-check: $candidate is older than python $minimum." >&2
    echo "  This check reads no TOML and runs no process, so $minimum is the floor" >&2
    echo "  it inherited from harness/anywaye_contract.py. It needs no packages." >&2
    exit 2
  fi
  # `exec`, so the module's exit code is this script's exit code and its PID is
  # the job's PID. The one thing a caller branches on is passed through
  # untouched — that is the entire job of this file.
  exec "$candidate" "$module" "$@"
done

echo "db-isolation-check: no python >= $minimum found on PATH." >&2
echo "  Set ANYWAYE_DB_ISOLATION_PYTHON to an interpreter, or install one." >&2
echo "  db-isolation-check needs no packages, so any python >= $minimum is enough." >&2
exit 2