#!/bin/sh
# A CPython that genuinely IS new enough, standing in for the one the search is
# supposed to walk on to.
#
# It delegates to a REAL interpreter named by $ANYWAYE_FIXTURE_PYTHON, and the
# case sets that to `sys.executable` of the interpreter already running this
# script. Delegating rather than answering the probe with a hardcoded `exit 0`
# is the whole point: the version check has to be a fact about a real
# CPython, or the fixture would pass a search that stopped early just as
# happily as one that walked.
#
# $ANYWAYE_FIXTURE_PYTHON is deliberately NOT resolved at build time and not
# hardcoded in the file. A committed path to one developer's python would make
# this fixture pass on the machine that wrote it and fail on every other one —
# and a red proof that depends on the machine is not a red proof. `sys.executable`
# is asked for at run time precisely so the fixture has no opinion about which
# python answers.
#
# Exit 2, never 0, when the delegation target is missing. A fixture that cannot
# do the job it exists for must not be able to report that it did.
if [ -n "${ANYWAYE_FIXTURE_TRACE:-}" ]; then
  printf '%s\n' "${0##*/}" >> "$ANYWAYE_FIXTURE_TRACE"
fi
if [ -z "${ANYWAYE_FIXTURE_PYTHON:-}" ]; then
  echo "interpreter-path fixture: ${0##*/} has no ANYWAYE_FIXTURE_PYTHON to delegate to." >&2
  echo "  It was not run, and a fixture that did not run is not a pass." >&2
  exit 2
fi
exec "$ANYWAYE_FIXTURE_PYTHON" "$@"