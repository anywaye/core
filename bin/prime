#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(dirname "$here")"
venv="$root/tests/.venv"
python="$venv/bin/python"

if [ ! -x "$python" ]; then
  "$root/tests/setup.sh"
fi

cd "$root"

echo "==> the gate is declared, and the declaration is true about this tree"
"$python" "$root/harness/gate_check.py" .


echo
echo "==> every tombstoned property name is still reserved, and every reservation resolves"

code=0
"$root/harness/bin/reserved-check" "$root" || code=$?
if [ "$code" -eq 2 ]; then
  echo "bin/prime: the reserved-tombstone check could not run (exit 2). This is not a pass:" >&2
  echo "  a checker that could not read the fleet has not checked it." >&2
  exit 2
elif [ "$code" -ne 0 ]; then
  echo "bin/prime: the reserved-tombstone check FAILED (exit $code). A name that is" >&2
  echo "  reserved and live, or a tombstone for a name nobody ever had, is a wire-" >&2
  echo "  unsafe contract above; see docs/reserved-properties.md." >&2
  exit 1
fi

db_isolation_red_proof() {
  local interpreter="$1"
  local red_proof="$root/harness/tests/db_isolation_self_test.sh"

  if [ ! -r "$red_proof" ]; then
    echo "bin/prime: precondition missing — the db-isolation guard's red proof is not" >&2
    echo "  readable at $red_proof. It was not run, and a red proof that did not run" >&2
    echo "  is not a pass." >&2
    return 1
  fi
  if ! command -v bash >/dev/null 2>&1; then
    echo "bin/prime: precondition missing — no bash on PATH, and the red proof is a" >&2
    echo "  bash script. It was not run, and a red proof that did not run is not a" >&2
    echo "  pass." >&2
    return 1
  fi

  local log report
  log="$(mktemp)"
  trap 'rm -f "$log"' RETURN

  if ! bash "$red_proof" >"$log" 2>&1; then
    echo "bin/prime: the db-isolation guard's red proof FAILED." >&2
    sed 's/^/  /' "$log" >&2
    echo "  A guard that cannot go red is not a guard. See harness/db_isolation_check.py." >&2
    return 1
  fi

  report="$(cat "$log")"
  local summary reds controls
  summary="$(printf '%s\n' "$report" | grep -E '^[0-9]+ passed, [0-9]+ failed$' | tail -n 1 || true)"
  if [ -z "$summary" ]; then
    echo "bin/prime: the db-isolation red proof exited 0 and printed no summary line." >&2
    printf '%s\n' "$report" | sed 's/^/  /' >&2
    echo "  An exit code with no report is not a pass." >&2
    return 1
  fi
  reds="$(printf '%s\n' "$report" | grep -c '^  red, and named' || true)"
  controls="$(printf '%s\n' "$report" | grep -c '^  clean  ' || true)"
  if [ "$reds" -lt 3 ]; then
    echo "bin/prime: the db-isolation red proof reported only $reds breakage(s) going red." >&2
    echo "  Three are expected: the shared-truncate hazard, the table-wide DELETE," >&2
    echo "  and the two-of-three latent suite." >&2
    return 1
  fi
  if [ "$controls" -lt 4 ]; then
    echo "bin/prime: the db-isolation red proof reported only $controls clean control(s)." >&2
    echo "  Four are expected: the unbroken control, the WHERE-narrowed delete, the" >&2
    echo "  comment using the word truncate, the same truncate behind a per-test" >&2
    echo "  schema, and the test double." >&2
    return 1
  fi

  echo "==> db_isolation red proof: $reds breakages went red naming their finding,"
  echo "  $controls clean controls stayed clean, and the control passed first: $summary"
}

reserved_red_proof() {
  local interpreter="$1"
  local red_proof="$root/harness/tests/reserved_self_test.sh"

  if [ ! -r "$red_proof" ]; then
    echo "bin/prime: precondition missing — the reserved checker's red proof is not" >&2
    echo "  readable at $red_proof. It was not run, and a red proof that did not run" >&2
    echo "  is not a pass." >&2
    return 1
  fi
  if ! command -v bash >/dev/null 2>&1; then
    echo "bin/prime: precondition missing — no bash on PATH, and the red proof is a" >&2
    echo "  bash script. It was not run, and a red proof that did not run is not a" >&2
    echo "  pass." >&2
    return 1
  fi
  if ! "$interpreter" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)'; then
    echo "bin/prime: precondition missing — the reserved red proof needs CPython >= 3.9," >&2
    echo "  and tests/.venv has $("$interpreter" -c 'import sys; print("%d.%d" % sys.version_info[:2])')." >&2
    echo "  It was not run, and a red proof that did not run is not a pass." >&2
    return 1
  fi

  export ANYWAYE_RESERVED_PYTHON="$interpreter"

  echo
  echo "==> the reserved checker can fail — its own red proof, on $("$interpreter" \
    -c 'import platform; print("python " + platform.python_version())')"

  local log code=0
  log="$(mktemp "${TMPDIR:-/tmp}/anywaye-reserved-red-proof.XXXXXX")"

  set +e
  bash "$red_proof" 2>&1 | tee "$log"
  code=${PIPESTATUS[0]}
  set -e

  if [ "$code" -ne 0 ]; then
    echo "bin/prime: the reserved checker's red proof FAILED (exit $code). Neither this" >&2
    echo "  gate nor the check above it is a pass: a checker that cannot be shown to" >&2
    echo "  fail cannot be trusted to have failed anything. Full output: $log" >&2
    return 1
  fi

  local claimed logged controls
  claimed="$(count_line 'breakages that went RED naming their finding' "$log")"
  logged="$(grep -c '^PASS reserved_self_test: breakage' "$log" || true)"
  controls="$(grep -c '^PASS reserved_self_test: the control' "$log" || true)"

  if [ -z "$claimed" ]; then
    echo "bin/prime: the reserved red proof exited 0 without reporting its counts." >&2
    echo "  An exit code is not a proof that anything ran; re-read its output at" >&2
    echo "  $log and fix whichever row stopped being printed. This gate refuses to" >&2
    echo "  report a pass over it." >&2
    return 1
  fi

  if [ "$controls" -lt 2 ]; then
    echo "bin/prime: the reserved red proof ran $controls controls. It runs at least two," >&2
    echo "  first: core's own tree and the conforming fixture. Without them the reds" >&2
    echo "  below prove nothing, because a checker that refused everything would" >&2
    echo "  satisfy every one of them." >&2
    return 1
  fi

  if [ "$logged" -lt "$claimed" ]; then
    echo "bin/prime: the reserved red proof counted $claimed breakages and logged" >&2
    echo "  $logged. Something in it stopped running without saying so. Full" >&2
    echo "  output: $log" >&2
    return 1
  fi

  rm -f "$log"

  echo
  echo "==> the reserved red proof passed: $claimed breakages went red naming their" \
    "finding, $controls controls green, including core's own tree."
}

account_scope_red_proof() {
  local interpreter="$1"
  local red_proof="$root/harness/tests/account_scope_self_test.sh"

  if [ ! -r "$red_proof" ]; then
    echo "bin/prime: precondition missing — the account-scope checker's red proof is not" >&2
    echo "  readable at $red_proof. It was not run, and a red proof that did not run is" >&2
    echo "  not a pass." >&2
    return 1
  fi
  if ! command -v bash >/dev/null 2>&1; then
    echo "bin/prime: precondition missing — no bash on PATH, and the red proof is a bash" >&2
    echo "  script. It was not run, and a red proof that did not run is not a pass." >&2
    return 1
  fi
  if ! "$interpreter" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)'; then
    echo "bin/prime: precondition missing — the account-scope red proof needs CPython >= 3.9," >&2
    echo "  and tests/.venv has $("$interpreter" -c 'import sys; print("%d.%d" % sys.version_info[:2])')." >&2
    echo "  It was not run, and a red proof that did not run is not a pass." >&2
    return 1
  fi

  export ANYWAYE_ACCOUNT_SCOPE_PYTHON="$interpreter"

  echo
  echo "==> the account-scope checker can fail — its own red proof, on $("$interpreter" \
    -c 'import platform; print("python " + platform.python_version())')"

  local log
  log="$(mktemp "${TMPDIR:-/tmp}/anywaye-account-scope-red-proof.XXXXXX")"

  local code=0
  set +e
  bash "$red_proof" 2>&1 | tee "$log"
  code=${PIPESTATUS[0]}
  set -e

  if [ "$code" -ne 0 ]; then
    echo "bin/prime: the account-scope checker's red proof FAILED (exit $code). Neither this" >&2
    echo "  gate nor the checks above it is a pass: a checker that cannot be shown to fail" >&2
    echo "  cannot be trusted to have failed anything. Full output: $log" >&2
    return 1
  fi

  local summary cases failures
  summary="$(grep -E '^[0-9]+ passed, [0-9]+ failed$' "$log" | tail -n 1 || true)"
  if [ -z "$summary" ]; then
    echo "bin/prime: the account-scope red proof exited 0 without reporting its counts." >&2
    printf '%s\n' "$(tail -20 "$log")" | sed 's/^/  /' >&2
    echo "  An exit code is not a proof that anything ran. This gate refuses to report a" >&2
    echo "  pass over it." >&2
    return 1
  fi
  cases="${summary%% passed*}"
  failures="${summary#*, }"
  failures="${failures%% *}"
  if [ "$failures" -ne 0 ]; then
    echo "bin/prime: the account-scope red proof reported $failures failed case(s) and" >&2
    echo "  exited 0. Its status and its report disagree, and a gate that believes the" >&2
    echo "  first one is a gate that can be lied to. Full output: $log" >&2
    return 1
  fi
  if [ "$cases" -lt 32 ]; then
    echo "bin/prime: the account-scope red proof ran $cases case(s); 32 is the floor it was" >&2
    echo "  written at. A proof that quietly stops running cases is how a checker stops" >&2
    echo "  being proved able to fail. Full output: $log" >&2
    return 1
  fi

  rm -f "$log"

  echo
  echo "==> the account-scope red proof passed: $cases cases and $failures failed, every"
  echo "  red one naming the finding it planted."
}

if [ "${1:-}" = "--pytest" ]; then
  "$python" -m pytest tests -q
else
  "$python" tests/test_specs.py
fi

count_line() {
  grep -F "$1" "$2" | grep -E '^  .*: [0-9]+$' | tail -1 | awk '{print $NF}' || true
}

gate_red_proof() {
  local interpreter="$1"
  local red_proof="$root/harness/tests/gate_self_test.sh"

  if [ ! -r "$red_proof" ]; then
    echo "bin/prime: precondition missing — the gate checker's red proof is not readable at" >&2
    echo "  $red_proof. It was not run, and a red proof that did not run is not a pass." >&2
    return 1
  fi
  if ! command -v bash >/dev/null 2>&1; then
    echo "bin/prime: precondition missing — no bash on PATH, and the red proof is a bash" >&2
    echo "  script. It was not run, and a red proof that did not run is not a pass." >&2
    return 1
  fi
  if ! "$interpreter" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
    echo "bin/prime: precondition missing — the red proof needs CPython >= 3.11 for tomllib," >&2
    echo "  and tests/.venv has $("$interpreter" -c 'import sys; print("%d.%d" % sys.version_info[:2])')." >&2
    echo "  It was not run, and a red proof that did not run is not a pass." >&2
    return 1
  fi

  export ANYWAYE_GATE_PYTHON="$interpreter"

  echo
  echo "==> the gate checker can fail — its own red proof, on $("$interpreter" \
    -c 'import platform; print("python " + platform.python_version())')"

  local log
  log="$(mktemp "${TMPDIR:-/tmp}/anywaye-gate-red-proof.XXXXXX")"

  local code=0
  set +e
  bash "$red_proof" 2>&1 | tee "$log"
  code=${PIPESTATUS[0]}
  set -e

  if [ "$code" -ne 0 ]; then
    echo "bin/prime: the gate checker's red proof FAILED (exit $code). Nothing below this" >&2
    echo "  line is a pass, and neither is this gate: a checker that cannot be shown to" >&2
    echo "  fail cannot be trusted to have failed anything. Full output: $log" >&2
    return 1
  fi

  local red warnings colour_green colour_red shapes extractors leak control skipped
  red="$(count_line 'breakages that went RED' "$log")"
  warnings="$(count_line 'warning cases that stayed GREEN' "$log")"
  colour_green="$(count_line 'green cases that matched a colour-bearing gate' "$log")"
  colour_red="$(count_line 'colour reds that still went red' "$log")"
  shapes="$(count_line 'real-workflow shapes that were ACCEPTED' "$log")"
  extractors="$(count_line 'extractor assertions' "$log")"
  leak="$(count_line 'the case that kept a secret out of the report' "$log")"
  control="$(count_line 'the control' "$log")"
  skipped="$(count_line 'SKIPPED' "$log")"

  for row in "$red" "$warnings" "$colour_green" "$colour_red" "$shapes" \
    "$extractors" "$leak" "$control" "$skipped"; do
    if [ -z "$row" ]; then
      echo "bin/prime: the red proof exited 0 without reporting its counts. An exit code is" >&2
      echo "  not a proof that anything ran; re-read its output at $log and fix whichever" >&2
      echo "  row stopped being printed. This gate refuses to report a pass over it." >&2
      return 1
    fi
  done

  if [ "$skipped" -ne 0 ]; then
    echo "bin/prime: the red proof reported $skipped skipped cases. A skip is a claim this" >&2
    echo "  machine could not settle, and a case that could not run is reported or it is" >&2
    echo "  not counted. Refusing to report a pass. Full output: $log" >&2
    return 1
  fi

  if [ "$control" -ne 1 ]; then
    echo "bin/prime: the red proof reported $control controls. It runs one, first: without it," >&2
    echo "  reds alone prove nothing, because a checker that refused everything would" >&2
    echo "  satisfy every one of them." >&2
    return 1
  fi

  if ! grep -q '^PASS gate_self_test: the control' "$log"; then
    echo "bin/prime: the red proof's counts block claims a control, and no control ever" >&2
    echo "  printed its PASS line. The row and the run have come apart. Full output: $log" >&2
    return 1
  fi

  local logged
  logged="$(grep -c '^PASS gate_self_test:' "$log" || true)"
  local claimed=$(( red + warnings + colour_green + colour_red + shapes + extractors + leak ))
  if [ "$logged" -lt "$claimed" ]; then
    echo "bin/prime: the red proof counted $claimed cases and logged $logged. Something in it" >&2
    echo "  stopped running without saying so. Full output: $log" >&2
    return 1
  fi

  rm -f "$log"

  echo
  echo "==> the red proof passed: $red breakages went red naming their finding," \
    "$warnings warning cases stayed green, $shapes real-workflow spellings accepted," \
    "$extractors extractor assertions, $colour_green colour-greens, $colour_red colour reds," \
    "the control green, and $skipped skipped."
}

gate_red_proof "$python"

numeric_target="${ANYWAYE_NUMERIC_PYTHON:-$python}"
if ! "$numeric_target" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' \
  >/dev/null 2>&1; then
  echo "bin/prime: precondition missing — the numeric check needs CPython >= 3.9, and" >&2
  echo "  $numeric_target is $("$numeric_target" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || echo unknown)." >&2
  echo "  It was not run, and a check that did not run is not a pass." >&2
  exit 1
fi

echo
echo "==> the contract's numeric surface is safe across six languages"
"$numeric_target" "$root/harness/numeric_check.py" schemas
gate_red_proof "$python"

reserved_red_proof "$python"

db_isolation_target="${ANYWAYE_DB_ISOLATION_PYTHON:-$python}"
if ! "$db_isolation_target" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' \
  >/dev/null 2>&1; then
  echo "bin/prime: precondition missing — the db-isolation check needs CPython >= 3.9, and" >&2
  echo "  $db_isolation_target is $("$db_isolation_target" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || echo unknown)." >&2
  echo "  It was not run, and a check that did not run is not a pass." >&2
  exit 1
fi

echo
echo "==> no test in this suite can delete another test's fixtures"
"$db_isolation_target" "$root/harness/db_isolation_check.py" .

echo
echo "==> the db-isolation guard can fail (8 cases: 3 reds, 5 clean controls)"
db_isolation_red_proof "$python"

account_scope_red_proof "$python"

# comment ban enforcement
if [ -f ../platform/scripts/commentlint.py ]; then
  python3 ../platform/scripts/commentlint.py . || exit 1
fi
